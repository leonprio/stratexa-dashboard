rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 🛡️ NUCLEAR ISOLATION FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // Canonical platform authority. The exact-email bridge is deliberately
    // temporary and applies only to Tablero helpers in this shared project.
    function isPlatformAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/tbl_platformAdmins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/tbl_platformAdmins/$(request.auth.uid)).data.uid == request.auth.uid &&
          get(/databases/$(database)/documents/tbl_platformAdmins/$(request.auth.uid)).data.status == 'active') ||
        request.auth.token.email in [
        'leon@leonprior.com',
        'leonprior@gmail.com'
        ]
      );
    }

    // Validador de Pertenencia: Un usuario solo accede a su propia burbuja o si es SuperAdmin
    function isTableroUser() {
      return isSuperAdmin() || exists(/databases/$(database)/documents/tbl_users/$(request.auth.uid));
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/tbl_users/$(request.auth.uid)).data;
    }

    function isStratexaAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/tbl_users/$(request.auth.uid)) &&
        (getUserProfile().globalRole == 'Admin' || getUserProfile().globalRole == 'admin')
      );
    }

    // 🛡️ REGLA DE SEGURIDAD CONTRA INYECCIÓN REGEX: Valida que el ID del tenant sea alfanumérico seguro sin metacaracteres
    function isSafeClientId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9ÁÉÍÓÚÜÑáéíóúüñ_-]+$');
    }

    function membershipId(targetClientId) {
      return request.auth.uid + '__' + targetClientId;
    }

    function hasCanonicalMembership(targetClientId) {
      return isAuthenticated() && isSafeClientId(targetClientId) &&
        exists(/databases/$(database)/documents/tbl_userMemberships/$(membershipId(targetClientId)));
    }

    function activeCanonicalMembership(targetClientId) {
      return hasCanonicalMembership(targetClientId) &&
        get(/databases/$(database)/documents/tbl_userMemberships/$(membershipId(targetClientId))).data.userId == request.auth.uid &&
        get(/databases/$(database)/documents/tbl_userMemberships/$(membershipId(targetClientId))).data.clientId == targetClientId &&
        get(/databases/$(database)/documents/tbl_userMemberships/$(membershipId(targetClientId))).data.status == 'active';
    }

    // Compatibility is available only before a canonical record exists. An
    // inactive/suspended canonical document therefore revokes the legacy path.
    function legacyTenantUser(targetClientId) {
      return isAuthenticated() &&
        isSafeClientId(targetClientId) &&
        exists(/databases/$(database)/documents/tbl_users/$(request.auth.uid)) &&
        !hasCanonicalMembership(targetClientId) &&
        (
          getUserProfile().clientId == targetClientId ||
          getUserProfile().clientId.matches('(.*,|^)\\s*' + targetClientId + '\\s*(,.*|$)')
        );
    }

    function isTenantUser(targetClientId) { return canReadBusinessData(targetClientId); }

    function hasLegacyPlatformBusinessReadBridge() {
      return request.auth != null && request.auth.token.email in [
        'leon@leonprior.com', 'leonprior@gmail.com'
      ];
    }

    function hasLegacyPlatformBusinessWriteBridge() {
      return hasLegacyPlatformBusinessReadBridge();
    }

    function isTenantAdmin(targetClientId) {
      // The bridge preserves current operational SuperAdmin writes without
      // treating canonical platform_admin identity as tenant administration.
      return hasLegacyPlatformBusinessWriteBridge() || (activeCanonicalMembership(targetClientId) &&
        get(/databases/$(database)/documents/tbl_userMemberships/$(membershipId(targetClientId))).data.role == 'tenant_admin') ||
        (!hasCanonicalMembership(targetClientId) && isStratexaAdmin() && legacyTenantUser(targetClientId));
    }

    function canReadBusinessData(clientId) {
      return hasLegacyPlatformBusinessReadBridge() || activeCanonicalMembership(clientId) || legacyTenantUser(clientId);
    }
    function canWriteBusinessData(clientId) {
      return hasLegacyPlatformBusinessWriteBridge() || isTenantAdmin(clientId);
    }
    function canAdminPlatform() { return isPlatformAdmin(); }
    function canAdminTenant(clientId) { return isTenantAdmin(clientId); }
    function isSuperAdmin() { return canAdminPlatform(); }
    function canReadTableroTenant(clientId) { return canReadBusinessData(clientId); }

    function dashboardRole(data, dashboardId) {
      let access = getUserProfile().get('dashboardAccess', {});
      return access.get(dashboardId, access.get(string(data.get('originalId', '')), ''));
    }

    function canonicalDashboardScope(data, dashboardId) {
      let membership = get(/databases/$(database)/documents/tbl_userMemberships/$(membershipId(data.clientId))).data;
      return dashboardId in membership.allowedDashboardIds || string(data.get('originalId', '')) in membership.allowedDashboardIds;
    }

    function canonicalDirectorScope(data) {
      let membership = get(/databases/$(database)/documents/tbl_userMemberships/$(membershipId(data.clientId))).data;
      return membership.role == 'director' && (
        data.get('directionId', '') in membership.hierarchyScopeKeys ||
        data.get('areaId', '') in membership.hierarchyScopeKeys
      );
    }

    function directorScope(data) {
      let user = getUserProfile();
      let group = data.get('group', '');
      return user.get('globalRole', '') in ['Director', 'director'] && group != '' && (
        group == user.get('directorTitle', '') ||
        group in user.get('subGroups', []) ||
        (data.get('superGroup', '') != '' && data.get('superGroup', '') in user.get('superGroups', []))
      );
    }

    function canReadDashboard(data, dashboardId) {
      return hasLegacyPlatformBusinessReadBridge() || (canReadTableroTenant(data.clientId) && (
        isTenantAdmin(data.clientId) ||
        (activeCanonicalMembership(data.clientId) && (canonicalDashboardScope(data, dashboardId) || canonicalDirectorScope(data))) ||
        (!hasCanonicalMembership(data.clientId) && (
          getUserProfile().get('dashboardAccess', {}).get(dashboardId, '') in ['Viewer', 'Editor'] ||
          getUserProfile().get('dashboardAccess', {}).get(string(data.get('originalId', '')), '') in ['Viewer', 'Editor'] ||
          directorScope(data)
        ))
      ));
    }

    function canEditDashboard(data, dashboardId) {
      return hasLegacyPlatformBusinessWriteBridge() || (isTenantUser(data.clientId) && (
        isTenantAdmin(data.clientId) ||
        (activeCanonicalMembership(data.clientId) && canonicalDashboardScope(data, dashboardId) &&
          'editor' in get(/databases/$(database)/documents/tbl_userMemberships/$(membershipId(data.clientId))).data.capabilities) ||
        (!hasCanonicalMembership(data.clientId) && (dashboardRole(data, dashboardId) == 'Editor' ||
          (dashboardRole(data, dashboardId) == '' && directorScope(data))))
      ));
    }

    function canEditActionPlan(data) {
      let dashboardId = string(data.dashboardId);
      let board = get(/databases/$(database)/documents/tbl_dashboards/$(dashboardId)).data;
      return board.clientId == data.clientId && canEditDashboard(board, dashboardId);
    }

    function canManageProfile(data) {
      // Multi-tenant directory administration needs all memberships, not one
      // overlapping tenant. Keep it platform-only until that contract exists.
      return isPlatformAdmin() || (isSafeClientId(data.clientId) && isTenantAdmin(data.clientId));
    }

    function validMembership(data) {
      return data.userId is string && data.clientId is string &&
        isSafeClientId(data.clientId) &&
        data.membershipId == data.userId + '__' + data.clientId &&
        data.role in ['tenant_admin', 'director', 'standard_user'] &&
        data.status in ['active', 'inactive', 'suspended'] &&
        data.scopeType in ['tenant', 'hierarchy', 'dashboard'] &&
        data.allowedDashboardIds is list && data.hierarchyScopeKeys is list &&
        data.capabilities is list && data.schemaVersion == 1 &&
        data.createdBy is string && data.updatedBy is string;
    }

    function sameMembershipIdentity(before, after) {
      return after.userId == before.userId && after.clientId == before.clientId &&
        after.membershipId == before.membershipId && after.createdAt == before.createdAt &&
        after.createdBy == before.createdBy && after.schemaVersion == before.schemaVersion;
    }

    function validTenantProfile(data) {
      return data.globalRole in ['Admin', 'Director', 'Member'] &&
        !(data.get('email', '').lower() in ['leon@leonprior.com', 'leonprior@gmail.com']);
    }

    function isStrategyCounterIdForClient(counterId, targetClientId) {
      return isSafeClientId(targetClientId) &&
        counterId.matches('^cnt_' + targetClientId + '_(OE|OC_.+)$');
    }

    function canInitializeStrategyCounter(counterId) {
      return isSuperAdmin() || (
        isStratexaAdmin() &&
        isSafeClientId(getUserProfile().clientId) &&
        isStrategyCounterIdForClient(counterId, getUserProfile().clientId)
      );
    }

    function isGobernanzaUser() {
      return isAuthenticated(); // Legacy permit: don't break Governance app
    }

    function isVacantesUser() {
      return isAuthenticated(); // Legacy permit: don't break Vacancy app
    }

    function isActivadorUser() {
      return isAuthenticated(); // Legacy permit: don't break Activador app
    }

    // --- 1. AISLAMIENTO: TABLERO (tbl_*) ---
    match /tbl_users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isPlatformAdmin() || (
        isSafeClientId(resource.data.clientId) && isTenantUser(resource.data.clientId) &&
        getUserProfile().globalRole in ['Admin', 'admin', 'Director', 'director']
      ));
      allow create: if isPlatformAdmin() || (isAuthenticated() && request.auth.uid != userId &&
        canManageProfile(request.resource.data) && validTenantProfile(request.resource.data));
      allow update: if isPlatformAdmin() || (isAuthenticated() && request.auth.uid != userId &&
        canManageProfile(resource.data) && validTenantProfile(request.resource.data) &&
        request.resource.data.clientId == resource.data.clientId &&
        request.resource.data.get('email', '') == resource.data.get('email', '') &&
        request.resource.data.get('id', userId) == resource.data.get('id', userId));
      // There is no current profile self-edit UX; deny self writes by default.
      allow delete: if isPlatformAdmin() || (isAuthenticated() && request.auth.uid != userId && canManageProfile(resource.data));
    }
    match /tbl_platformAdmins/{uid} {
      // This collection is platform authority only, never a business-data grant.
      allow read: if isAuthenticated() && (request.auth.uid == uid || isPlatformAdmin());
      allow create: if isPlatformAdmin() && request.resource.data.uid == uid &&
        request.resource.data.status in ['active', 'disabled'] && request.resource.data.schemaVersion == 1;
      allow update: if isPlatformAdmin() && request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.schemaVersion == resource.data.schemaVersion &&
        request.resource.data.status in ['active', 'disabled'];
      allow delete: if isPlatformAdmin();
    }
    match /tbl_userMemberships/{membershipIdValue} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid ||
        isPlatformAdmin() || isTenantAdmin(resource.data.clientId));
      // Tenant admins manage other users only in their own tenant. They cannot
      // manufacture or alter their own authority document.
      allow create: if validMembership(request.resource.data) && membershipIdValue == request.resource.data.membershipId &&
        (isPlatformAdmin() || (isTenantAdmin(request.resource.data.clientId) && request.resource.data.userId != request.auth.uid));
      allow update: if validMembership(request.resource.data) && sameMembershipIdentity(resource.data, request.resource.data) &&
        (isPlatformAdmin() || (isTenantAdmin(resource.data.clientId) && resource.data.userId != request.auth.uid));
      allow delete: if isPlatformAdmin() || (isTenantAdmin(resource.data.clientId) && resource.data.userId != request.auth.uid);
    }
    match /tbl_directions/{directionId} {
      allow read: if isTableroUser() && isTenantUser(resource.data.clientId);
      allow create: if isTableroUser() && isTenantAdmin(request.resource.data.clientId) &&
        request.resource.data.id == directionId && request.resource.data.status in ['active', 'inactive'];
      allow update: if isTableroUser() && isTenantAdmin(resource.data.clientId) &&
        request.resource.data.clientId == resource.data.clientId && request.resource.data.id == resource.data.id;
      allow delete: if isTableroUser() && isTenantAdmin(resource.data.clientId);
    }
    match /tbl_areas/{areaId} {
      allow read: if isTableroUser() && isTenantUser(resource.data.clientId);
      allow create: if isTableroUser() && isTenantAdmin(request.resource.data.clientId) &&
        request.resource.data.id == areaId && request.resource.data.status in ['active', 'inactive'];
      allow update: if isTableroUser() && isTenantAdmin(resource.data.clientId) &&
        request.resource.data.clientId == resource.data.clientId && request.resource.data.id == resource.data.id;
      allow delete: if isTableroUser() && isTenantAdmin(resource.data.clientId);
    }
    match /tbl_dashboards/{docId} {
      allow read: if isTableroUser() && canReadDashboard(resource.data, docId);
      allow create: if isTableroUser() && isSafeClientId(request.resource.data.clientId) && isTenantAdmin(request.resource.data.clientId);
      allow update: if isTableroUser() && isTenantAdmin(resource.data.clientId) && request.resource.data.clientId == resource.data.clientId;
      allow delete: if isTableroUser() && isTenantAdmin(resource.data.clientId);
      match /items/{itemId} {
        allow read: if isTableroUser() && canReadDashboard(get(/databases/$(database)/documents/tbl_dashboards/$(docId)).data, docId);
        allow write: if isTableroUser() && canEditDashboard(get(/databases/$(database)/documents/tbl_dashboards/$(docId)).data, docId);
      }
    }
    match /tbl_systemSettings/{id} {
      allow read: if isTableroUser() && (id in ['main', 'MAIN'] || canReadTableroTenant(id));
      allow write: if isPlatformAdmin() || (!(id in ['main', 'MAIN']) && isTenantAdmin(id));
    }
    match /tbl_managedClients/{id} {
      allow read: if isTableroUser() && canReadTableroTenant(id);
      allow write: if isPlatformAdmin() || isTenantAdmin(id);
    }
    match /tbl_actionPlans/{planId} {
      allow read: if isTableroUser() && isTenantUser(resource.data.clientId);
      allow create: if isTableroUser() && isSafeClientId(request.resource.data.clientId) && canEditActionPlan(request.resource.data);
      allow update: if isTableroUser() && canEditActionPlan(resource.data) &&
        request.resource.data.clientId == resource.data.clientId &&
        request.resource.data.dashboardId == resource.data.dashboardId &&
        request.resource.data.get('indicatorId', '') == resource.data.get('indicatorId', '');
      allow delete: if isTableroUser() && canEditActionPlan(resource.data);
    }

    // --- 🎯 REGLAS DE SEGURIDAD SERVIDORA: ESTRATEGIA (v9.5.0 FOUNDATION) ---
    match /tbl_strategicPerspectives/{docId} {
      allow read: if isTableroUser() && (resource == null || isTenantUser(resource.data.clientId));
      allow create: if isTableroUser() && isSafeClientId(request.resource.data.clientId) && isTenantAdmin(request.resource.data.clientId);
      allow update: if isTableroUser() && isSafeClientId(resource.data.clientId) && isTenantAdmin(resource.data.clientId) && request.resource.data.clientId == resource.data.clientId;
      allow delete: if isTableroUser() && isTenantAdmin(resource.data.clientId);
    }

    match /tbl_strategicObjectives/{docId} {
      allow read: if isTableroUser() && (resource == null || isTenantUser(resource.data.clientId));
      allow create: if isTableroUser() && isSafeClientId(request.resource.data.clientId) && isTenantAdmin(request.resource.data.clientId);
      allow update: if isTableroUser() && isSafeClientId(resource.data.clientId) && isTenantAdmin(resource.data.clientId) && request.resource.data.clientId == resource.data.clientId;
      allow delete: if isTableroUser() && isTenantAdmin(resource.data.clientId);
    }

    match /tbl_areaStrategyConfigs/{docId} {
      allow read: if isTableroUser() && (resource == null || isTenantUser(resource.data.clientId));
      allow create: if isTableroUser() && isSafeClientId(request.resource.data.clientId) && isTenantAdmin(request.resource.data.clientId);
      allow update: if isTableroUser() && isSafeClientId(resource.data.clientId) && isTenantAdmin(resource.data.clientId) && request.resource.data.clientId == resource.data.clientId;
      allow delete: if isTableroUser() && isTenantAdmin(resource.data.clientId);
    }

    match /tbl_contributionObjectives/{docId} {
      allow read: if isTableroUser() && (resource == null || isTenantUser(resource.data.clientId));
      allow create: if isTableroUser() && isSafeClientId(request.resource.data.clientId) && isTenantAdmin(request.resource.data.clientId);
      allow update: if isTableroUser() && isSafeClientId(resource.data.clientId) && isTenantAdmin(resource.data.clientId) && request.resource.data.clientId == resource.data.clientId;
      allow delete: if isTableroUser() && isTenantAdmin(resource.data.clientId);
    }

    match /tbl_contributionIndicatorAssignments/{docId} {
      allow read: if isTableroUser() && (resource == null || isTenantUser(resource.data.clientId));
      allow create: if isTableroUser() && isSafeClientId(request.resource.data.clientId) && isTenantAdmin(request.resource.data.clientId);
      allow update: if isTableroUser() && isSafeClientId(resource.data.clientId) && isTenantAdmin(resource.data.clientId) && request.resource.data.clientId == resource.data.clientId;
      allow delete: if isTableroUser() && isTenantAdmin(resource.data.clientId);
    }

    match /tbl_strategyCounters/{docId} {
      allow get: if canInitializeStrategyCounter(docId);
      allow list: if isTableroUser() && isTenantAdmin(resource.data.clientId);
      allow create: if isTableroUser() &&
        isSafeClientId(request.resource.data.clientId) &&
        isStrategyCounterIdForClient(docId, request.resource.data.clientId) &&
        isTenantAdmin(request.resource.data.clientId);
      allow update: if isTableroUser() &&
        isSafeClientId(resource.data.clientId) &&
        isStrategyCounterIdForClient(docId, resource.data.clientId) &&
        isTenantAdmin(resource.data.clientId) &&
        request.resource.data.clientId == resource.data.clientId;
      allow delete: if isTableroUser() && isTenantAdmin(resource.data.clientId);
    }

    match /tbl_areaCodeReservations/{docId} {
      allow read: if isTableroUser() && (resource == null || isTenantUser(resource.data.clientId));
      allow create: if isTableroUser() && isSafeClientId(request.resource.data.clientId) && isTenantAdmin(request.resource.data.clientId);
      allow update: if isTableroUser() && isSafeClientId(resource.data.clientId) && isTenantAdmin(resource.data.clientId) && request.resource.data.clientId == resource.data.clientId;
      allow delete: if isTableroUser() && isTenantAdmin(resource.data.clientId);
    }

    match /tbl_strategicObjectiveRelationships/{docId} {
      allow read: if isTableroUser() && (resource == null || isTenantUser(resource.data.clientId));
      allow create: if isTableroUser() &&
        isSafeClientId(request.resource.data.clientId) &&
        isTenantAdmin(request.resource.data.clientId) &&
        request.resource.data.sourceStrategicObjectiveId is string &&
        request.resource.data.targetStrategicObjectiveId is string &&
        request.resource.data.sourceStrategicObjectiveId != request.resource.data.targetStrategicObjectiveId &&
        docId == 'rel_' + request.resource.data.clientId + '_' + request.resource.data.sourceStrategicObjectiveId + '_' + request.resource.data.targetStrategicObjectiveId &&
        exists(/databases/$(database)/documents/tbl_strategicObjectives/$(request.resource.data.sourceStrategicObjectiveId)) &&
        exists(/databases/$(database)/documents/tbl_strategicObjectives/$(request.resource.data.targetStrategicObjectiveId)) &&
        get(/databases/$(database)/documents/tbl_strategicObjectives/$(request.resource.data.sourceStrategicObjectiveId)).data.clientId == request.resource.data.clientId &&
        get(/databases/$(database)/documents/tbl_strategicObjectives/$(request.resource.data.targetStrategicObjectiveId)).data.clientId == request.resource.data.clientId;
      allow update: if isTableroUser() &&
        isSafeClientId(resource.data.clientId) &&
        isTenantAdmin(resource.data.clientId) &&
        request.resource.data.clientId == resource.data.clientId &&
        request.resource.data.sourceStrategicObjectiveId == resource.data.sourceStrategicObjectiveId &&
        request.resource.data.targetStrategicObjectiveId == resource.data.targetStrategicObjectiveId;
      allow delete: if isTableroUser() && isTenantAdmin(resource.data.clientId);
    }

    // --- 2. AISLAMIENTO: GOBERNANZA (cpx_*) ---
    match /cpx_users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isGobernanzaUser());
    }
    match /cpx_work_plans/{id=**} { allow read, write: if isGobernanzaUser(); }
    match /cpx_indicators/{id=**} { allow read, write: if isGobernanzaUser(); }
    match /cpx_reports/{id=**} { allow read, write: if isGobernanzaUser(); }

    // --- 3. AISLAMIENTO: VACANTES (vac_*) ---
    match /vac_users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isVacantesUser());
    }
    match /vac_weekly_data/{id=**} { allow read, write: if isVacantesUser(); }
    match /vac_weekly_analysis/{id=**} { allow read, write: if isVacantesUser(); }
    match /vac_config/{id=**} { allow read, write: if isVacantesUser(); }
    match /vac_unes/{id=**} { allow read, write: if isVacantesUser(); }

    match /stx_users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isActivadorUser());
    }
    match /stx_dashboards/{id=**} { allow read, write: if isActivadorUser(); }
    match /stx_history/{id=**} { allow read, write: if isActivadorUser(); }
    match /stx_managedClients/{id=**} { allow read, write: if isActivadorUser(); }
    match /stx_weekly_data/{id=**} { allow read, write: if isActivadorUser(); }
    match /stx_weekly_analysis/{id=**} { allow read, write: if isActivadorUser(); }
    match /stx_config/{id=**} { allow read: if isAuthenticated(); allow write: if isActivadorUser(); }
    match /stx_unes/{id=**} { allow read: if isAuthenticated(); allow write: if isActivadorUser(); }

    // --- 5. COMPATIBILIDAD Y LEGACY (Bloqueo Gradual) ---
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }
    
    match /dashboards/{id=**} { allow read, write: if isTableroUser() || isGobernanzaUser() || isActivadorUser() || isVacantesUser(); }
    match /weekly_data/{id=**} { allow read, write: if isTableroUser() || isGobernanzaUser() || isActivadorUser() || isVacantesUser(); }
    match /weekly_analysis/{id=**} { allow read, write: if isTableroUser() || isGobernanzaUser() || isActivadorUser() || isVacantesUser(); }
    match /config/{id=**} { allow read, write: if isTableroUser() || isGobernanzaUser() || isActivadorUser() || isVacantesUser(); }
    match /unes/{id=**} { allow read, write: if isTableroUser() || isGobernanzaUser() || isActivadorUser() || isVacantesUser(); }
    match /systemSettings/{id=**} { allow read, write: if isTableroUser() || isActivadorUser(); }
    match /managedClients/{id=**} { allow read, write: if isTableroUser() || isActivadorUser(); }
    match /history/{id=**} { allow read, write: if isTableroUser() || isActivadorUser(); }
    match /clients/{id=**} { allow read: if isTableroUser() || isGobernanzaUser() || isActivadorUser() || isVacantesUser(); }
    match /groups/{id=**} { allow read: if isTableroUser() || isGobernanzaUser() || isActivadorUser() || isVacantesUser(); }
    match /indicators/{id=**} { allow read: if isTableroUser() || isGobernanzaUser() || isActivadorUser() || isVacantesUser(); }
    match /directorates/{id=**} { allow read: if isTableroUser() || isGobernanzaUser() || isActivadorUser() || isVacantesUser(); }
    match /addresses/{id=**} { allow read: if isTableroUser() || isGobernanzaUser() || isActivadorUser() || isVacantesUser(); }
    match /ips_config/{id=**} { allow read: if isTableroUser() || isActivadorUser(); }
    match /ips_users/{id=**} { allow read: if isTableroUser() || isActivadorUser(); }
    match /ips_weekly_data/{id=**} { allow read, write: if isTableroUser() || isActivadorUser(); }
    match /ips_weekly_analysis/{id=**} { allow read, write: if isTableroUser() || isActivadorUser(); }


    // --- 🚨 REGLA DE COMPATIBILIDAD UNIVERSAL (AISLAMIENTO INTELIGENTE) 🚨 ---
    match /{collection}/{document=**} {
      allow read, write: if isAuthenticated() && 
        !collection.matches('^tbl_.*') &&
        !(collection in [
          'tbl_users', 'tbl_dashboards', 'tbl_systemSettings', 'tbl_managedClients',
          'tbl_strategicPerspectives', 'tbl_strategicObjectives', 'tbl_areaStrategyConfigs',
          'tbl_contributionObjectives', 'tbl_contributionIndicatorAssignments',
          'tbl_strategyCounters', 'tbl_areaCodeReservations', 'tbl_strategicObjectiveRelationships',
          'vac_users', 'vac_weekly_data', 'vac_weekly_analysis', 'vac_config', 'vac_unes',
          'cpx_users', 'cpx_work_plans', 'cpx_indicators', 'cpx_reports'
        ]);
    }
  }
}
